log_format dts_safe '$remote_addr $request_method $uri $status $request_time';
access_log /var/log/nginx/access.log dts_safe;
server {
  listen 80;
  absolute_redirect off;
  server_name ${DTS_PUBLIC_HOST};
  root /usr/share/nginx/html;
  client_max_body_size 64k;
  resolver 127.0.0.11 valid=10s ipv6=off;
  gzip on;
  gzip_types application/javascript application/json text/css application/octet-stream;
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy no-referrer always;
  add_header X-Frame-Options DENY always;
  location = /api/v1/results {
    client_max_body_size 256k;
    set $workbench_api http://api:8091;
    proxy_pass $workbench_api;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_http_version 1.1;
    proxy_buffering off;
    proxy_read_timeout 300s;
  }
  location /api/ {
    set $workbench_api http://api:8091;
    proxy_pass $workbench_api;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    # TLS ends at the external Tailscale reverse proxy. Never trust a
    # client-supplied scheme header on this HTTP-only internal hop.
    proxy_set_header X-Forwarded-Proto https;
    proxy_http_version 1.1;
    proxy_buffering off;
    proxy_read_timeout 300s;
  }
  location /assets/ {
    if ($uri ~ "(^|/)\.") { return 404; }
    if ($uri !~* "\.(js|css|woff2?|ttf|svg|png|ico|jpe?g|webp|avif|wasm)$") { return 404; }
    try_files $uri =404;
    add_header Cache-Control "public, max-age=31536000, immutable";
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "DENY" always;
    add_header Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'" always;
  }
  # Only the explicitly published landing package is anonymous.
  # Never expose the entire /landing directory or arbitrary JSON files.
  location ~ ^/landing/(mgts-original\.jpg|larp-corp-original\.jpg|visual-data\.json)$ {
    limit_except GET { deny all; }
    try_files $uri =404;
    add_header Cache-Control "no-cache" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "DENY" always;
    add_header Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'" always;
  }
  location = /_workbench_auth {
    internal;
    set $workbench_api http://api:8091;
    proxy_pass $workbench_api/api/v2/auth/guard;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header Host $http_host;
    proxy_set_header X-Original-URI $request_uri;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
  }
  # Public landing and account entry pages only; all work routes stay guarded.
  location ~ ^/(|login|activate|recover)$ {
    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "DENY" always;
    add_header Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'" always;
    try_files /index.html =404;
  }
  location / {
    auth_request /_workbench_auth;
    auth_request_set $login_redirect $upstream_http_x_login_redirect;
    error_page 401 = @login;
    error_page 500 502 503 = @auth_unavailable;
    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "DENY" always;
    add_header Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'" always;
    try_files $uri $uri/ /index.html;
  }
  location @login { return 303 $login_redirect; }
  location @auth_unavailable {
    default_type text/plain;
    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "DENY" always;
    add_header Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'" always;
    add_header Retry-After "10" always;
    return 503 "Account service temporarily unavailable. Retry shortly.\n";
  }
}
