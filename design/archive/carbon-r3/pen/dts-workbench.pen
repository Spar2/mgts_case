        {
          "type": "text",
          "id": "NNn1p",
          "x": 944,
          "y": 264,
          "name": "Каждый запуск фиксирует:\nверсию кода и конфигурацию,\nхеш исходного файла,\nсхему результатов и время выполнения.\n\nПараметры слева — reference DSP.\nСтроки истории — пример UX.",
          "fill": "$dts.text-secondary",
          "textGrowth": "fixed-width",
          "width": 464,
          "content": "Каждый запуск фиксирует:\nверсию кода и конфигурацию,\nхеш исходного файла,\nсхему результатов и время выполнения.\n\nПараметры слева — reference DSP.\nСтроки истории — пример UX.",
          "lineHeight": 1.3,
