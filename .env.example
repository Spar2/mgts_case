# Образец окружения dual-access (значения НЕ коммитить).
# Приватный файл — вне Git (umask 077), см. docs/web/PRODUCTION-OPERATOR.md.
# Проверка: python -m pytest services/web-api/tests/test_dual_access_contract.py
DTS_POSTGRES_PASSWORD=replace-with-a-random-private-password
DTS_RECORDS=/absolute/path/to/prepared/records
DTS_QUEUE=/absolute/path/to/verified/queue
DTS_RESEARCH_PACK=/absolute/path/to/real-data-v2
DTS_PUBLIC_HOST=example.com
DTS_PUBLIC_ORIGIN=https://example.com
DTS_TLS_PORT=8443
DTS_TLS_DIRECTORY=/absolute/private/path/to/tls
DTS_BACKUP_DIRECTORY=/absolute/private/path/to/encrypted-backups
DTS_BACKUP_RECIPIENT=age1-public-recipient-generated-off-server
# Пусто = роль пропускается (stub-режим). Токены только в env контроллера.
TAILSCALE_AUTH_KEY=
CLOUDFLARED_TUNNEL_TOKEN=
